# Copy to .env and fill in. Never commit the real file.

# Pooled Neon connection string (the host must contain "-pooler", or
# serverless functions will exhaust Postgres connections).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Signs session cookies. Generate with: openssl rand -base64 32
# Changing this logs every existing session out.
AUTH_SECRET=

# Required when the app is not served from localhost.
AUTH_TRUST_HOST=true

# Seeded admin account (prisma/seed.mjs). The seed is an idempotent upsert,
# so changing ADMIN_PASSWORD and re-running rotates the password.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Optional OAuth — leave blank to hide those buttons entirely.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
