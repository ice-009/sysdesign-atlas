// Postgres (Neon in production). DATABASE_URL comes from prisma.config.ts.
// For offline local work, `docker compose up -d db` gives you a local Postgres.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  /// "USER" | "ADMIN". String rather than enum so the schema works
  /// unchanged on both SQLite (local) and Postgres (k8s).
  role          String    @default("USER")
  /// Set when seeded with the default password; cleared on first change.
  mustChangePassword Boolean @default(false)
  suspended     Boolean   @default(false)

  // Study preferences
  targetRole    String?   @default("L5")
  targetCompany String?
  examDate      DateTime?

  accounts     Account[]
  sessions     Session[]
  progress     Progress[]
  bookmarks    Bookmark[]
  notes        Note[]
  activity     Activity[]
  subscription Subscription?
  invoices     Invoice[]
  deviceTokens DeviceToken[]
  syncRecords  SyncRecord[]
  syncState    SyncState?
}

/// One active subscription per user. Absent = free tier.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  /// "FREE" | "PRO" | "TEAM"
  plan   String @default("FREE")
  /// "active" | "trialing" | "past_due" | "canceled"
  status String @default("active")

  /// "monthly" | "yearly"
  interval String @default("monthly")
  seats    Int    @default(1)

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  trialEndsAt        DateTime?

  /// Populated only when a real payment provider is wired up.
  providerCustomerId     String?
  providerSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan, status])
}

/// Billing history. Written by the mock checkout and by any real webhook.
model Invoice {
  id       String   @id @default(cuid())
  userId   String
  plan     String
  /// Minor units (paise/cents) — never floats for money.
  amount   Int
  currency String   @default("INR")
  /// "paid" | "open" | "void" | "refunded"
  status   String   @default("paid")
  periodStart DateTime
  periodEnd   DateTime
  providerInvoiceId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Global key/value config an admin can flip at runtime without a deploy.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Append-only record of admin actions.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorEmail String?
  action    String
  targetId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One row per (user, topic). Tracks completion and confidence.
model Progress {
  id        String    @id @default(cuid())
  userId    String
  slug      String
  section   String
  completed Boolean   @default(false)
  /// 0 = unrated, 1 = shaky, 2 = ok, 3 = solid. Drives the review queue.
  confidence Int      @default(0)
  timeSpent Int       @default(0) // seconds
  lastViewed DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, section])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  slug      String
  section   String
  title     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

/// Free-form notes a user writes against a topic.
model Note {
  id        String   @id @default(cuid())
  userId    String
  slug      String
  section   String
  body      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

/// One row per day a user studied. Powers the streak and heatmap.
model Activity {
  id       String   @id @default(cuid())
  userId   String
  day      String // YYYY-MM-DD, local to the user
  minutes  Int      @default(0)
  topics   Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
}

/// Sign-in keys for the offline iPad app (/ipad). A Home Screen web app on iOS
/// gets its own cookie jar and can't use the website's session, so it signs in
/// once and keeps one of these instead. Only the SHA-256 of the key is stored.
model DeviceToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// The change log the iPad app syncs against. Holds its annotations
/// (highlights, ink strokes, sketch cards) and a mirror of progress, bookmarks
/// and notes so the website and the iPad agree. `id` is minted on the device,
/// which makes a retried upload a no-op; `clock` orders edits for
/// newest-edit-wins; deletes are kept as tombstones so they sync too.
model SyncRecord {
  userId    String
  id        String
  kind      String
  topic     String
  data      Json
  clock     String
  deleted   Boolean  @default(false)
  seq       BigInt
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, seq])
}

/// Per-user counter for SyncRecord.seq. It is bumped inside the same
/// transaction as the writes, which holds a row lock until commit, so sequence
/// numbers are handed out in commit order and "everything after #N" never
/// skips a row that committed late.
model SyncState {
  userId String @id
  seq    BigInt @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
